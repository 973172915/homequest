# 复制为 .env 后填写。.env 已在 .gitignore 中，不会被提交。
# 留空时应用会自动降级为「检索 + 模板摘要」模式，仍可跑通演示。

# DeepSeek（官方模型 id 是 deepseek-flash）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 思考模式强度：low / high / max（RAG 生成建议 low，复杂对比再升档）
DEEPSEEK_REASONING_EFFORT=low

# HuggingFace 镜像（国内直连 huggingface.co 常超时）
HF_ENDPOINT=https://hf-mirror.com
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
